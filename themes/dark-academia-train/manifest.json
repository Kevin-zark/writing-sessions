 "intro": {
  "lines": [
   "Welcome, Writers...",
   "Find your seat. Open your story.",
   "The train to Hollowmere departs soon."
  ]
 },
 "breakText": [
  "The train pauses at the platform. Stretch. Sip something warm.",
  "Let the ideas settle while passengers come and go.",
  "Breathe. The story will wait."
 ],
 "breakEndText": "All aboard — the next sprint begins soon...",
 "outro": {
  "lines": [
   "Hollowmere, at last.",
   "Beautiful work, my friend!",
   "Until the next journey."
  ]
 }
